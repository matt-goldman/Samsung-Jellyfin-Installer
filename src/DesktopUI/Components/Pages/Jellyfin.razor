@page "/jellyfin"
@using Samsung_Jellyfin_Installer.Shared.ViewModels
@inject JellyfinConfigViewModel JellyfinViewModel
@inject MainWindowViewModel MainViewModel
@inject SettingsViewModel SettingsViewModel

<h1>Samsung Jellyfin Installer - MAUI</h1>

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <h3>Releases</h3>
            <div class="mb-3">
                <button class="btn btn-primary" @onclick="LoadReleases">Load Releases</button>
            </div>
            
            @if (MainViewModel.IsLoading)
            {
                <p>Loading releases...</p>
            }
            
            <p>Releases count: @MainViewModel.Releases.Count</p>
        </div>
        
        <div class="col-md-6">
            <h3>Devices</h3>
            <div class="mb-3">
                <button class="btn btn-secondary" @onclick="ScanDevices">Scan for Devices</button>
            </div>
            
            @if (MainViewModel.IsLoadingDevices)
            {
                <p>Scanning for devices...</p>
            }
            
            <p>Devices count: @MainViewModel.AvailableDevices.Count</p>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <h3>Settings</h3>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="SettingsViewModel.RememberCustomIP" id="rememberIP">
                <label class="form-check-label" for="rememberIP">
                    Remember Custom IP
                </label>
            </div>
            
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="SettingsViewModel.DeletePreviousInstall" id="deletePrevious">
                <label class="form-check-label" for="deletePrevious">
                    Delete Previous Install
                </label>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <div class="alert alert-info">
                <strong>Status:</strong> @MainViewModel.StatusBar
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private async Task LoadReleases()
    {
        try
        {
            // Simulate loading releases
            MainViewModel.IsLoading = true;
            StateHasChanged();
            
            await Task.Delay(2000); // Simulate API call
            
            MainViewModel.StatusBar = "Releases loaded successfully";
            MainViewModel.IsLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading releases: {ex.Message}");
            MainViewModel.IsLoading = false;
        }
    }

    private async Task ScanDevices()
    {
        try
        {
            // Simulate device scanning
            MainViewModel.IsLoadingDevices = true;
            StateHasChanged();
            
            await Task.Delay(2000); // Simulate device scan
            
            MainViewModel.StatusBar = "Device scan completed";
            MainViewModel.IsLoadingDevices = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error scanning devices: {ex.Message}");
            MainViewModel.IsLoadingDevices = false;
        }
    }
}
